# ============================================================
# BlueHope — Firebase environment configuration
# Copy this file to ".env.local" and fill in the values.
# .env.local is git-ignored; never commit real keys.
# Restart `npm run dev` after changing it.
# ============================================================

# --- Web app config (safe to expose to browsers) ---
# Firebase Console → Project settings → General → "Your apps" → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Admin SDK (SERVER ONLY — never expose, never commit) ---
# Firebase Console → Project settings → Service accounts → Generate new private key (JSON)
# Take these three values from that JSON file:
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the literal \n sequences from the JSON on one line:
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET=your-project-id.appspot.com