rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : "";
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isModerator() {
      return role() == "moderator" || isAdmin();
    }

    function ownsUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function unchangedProtectedFields(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function publicListing() {
      return resource.data.profileStatus == "active"
        && resource.data.moderationState != "rejected"
        && resource.data.moderationState != "hidden";
    }

    match /users/{uid} {
      allow read: if ownsUid(uid) || isModerator();
      allow create: if ownsUid(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ["customer", "soleProvider", "institution"];
      allow update: if ownsUid(uid)
        && unchangedProtectedFields([
          "uid",
          "role",
          "accountStatus",
          "trustScore",
          "createdAt",
          "deletedAt"
        ]);
      allow delete: if false;
    }

    match /emailIndex/{email} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        isModerator()
      );
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email
        && request.resource.data.role in ["customer", "soleProvider", "institution"]
        && !exists(/databases/$(database)/documents/emailIndex/$(email));
      allow update: if signedIn()
        && request.auth.uid == resource.data.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email
        && request.resource.data.role in ["customer", "soleProvider", "institution"]
        && unchangedProtectedFields(["uid", "email", "role", "createdAt"]);
      allow delete: if false;
    }

    match /customerProfiles/{uid} {
      allow read, create, update: if ownsUid(uid) || isModerator();
      allow delete: if false;
    }

    match /childProfiles/{childId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && unchangedProtectedFields(["ownerUid", "createdAt"]);
      allow delete: if false;
    }

    match /conditions/{conditionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /conditionSubcategories/{subcategoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /providerProfiles/{providerId} {
      allow read: if resource.data.profileStatus == "active" || request.auth.uid == resource.data.ownerUid || isModerator();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && unchangedProtectedFields([
          "ownerUid",
          "verificationStatus",
          "verificationDecision",
          "adminNotes",
          "trustScore",
          "ratingSummary",
          "reviewCount",
          "createdAt"
        ]);
      allow delete: if false;
    }

    match /institutionProfiles/{institutionId} {
      allow read: if resource.data.profileStatus == "active" || request.auth.uid == resource.data.ownerUid || isModerator();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.staffUids)
        && unchangedProtectedFields([
          "ownerUid",
          "verificationStatus",
          "verificationDecision",
          "adminNotes",
          "trustScore",
          "ratingSummary",
          "reviewCount",
          "createdAt"
        ]);
      allow delete: if false;
    }

    match /institutionStaff/{staffId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.staffUid == request.auth.uid ||
        isModerator()
      );
      allow write: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if publicListing() || request.auth.uid == resource.data.ownerUid || isModerator();
      allow create, update, delete: if false;
    }

    match /searchListings/{listingId} {
      allow read: if resource.data.profileStatus == "active";
      allow write: if false;
    }

    match /recommendationFeatures/{listingId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /savedProviders/{savedId} {
      allow read, delete: if signedIn() && request.auth.uid == resource.data.customerUid;
      allow create: if signedIn() && request.auth.uid == request.resource.data.customerUid;
      allow update: if false;
    }

    match /enquiries/{enquiryId} {
      // Customers open enquiries; status transitions happen through the app/backend.
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "open";
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.providerUid == request.auth.uid ||
        isModerator()
      );
      allow update: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.providerUid == request.auth.uid ||
        isModerator()
      )
      && unchangedProtectedFields(["customerUid", "listingId", "createdAt"]);
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      // Bookings always start as unpaid requests; payment/completion states are
      // finalized by trusted backend logic, never by client writes.
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "requested"
        && request.resource.data.paymentState in ["notRequired", "pending"];
      allow read, update: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.providerUid == request.auth.uid ||
        isModerator()
      )
      && unchangedProtectedFields(["customerUid", "listingId", "createdAt"]);
      allow delete: if false;
    }

    match /availabilitySlots/{slotId} {
      // Public read so parents can see open slots; only the slot owner may
      // create/change them, and ownership is immutable.
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && unchangedProtectedFields(["ownerUid", "createdAt"]);
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == "published" && resource.data.moderationState == "approved";
      // Reviews must be born untrusted: draft status, pending moderation, no
      // server-derived counters. The backend promotes/publishes after checks.
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == "draft"
        && request.resource.data.moderationState == "pending"
        && request.resource.data.verifiedBooking == false
        && request.resource.data.fraudFlags.size() == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.helpfulCount == 0;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && unchangedProtectedFields([
          "authorUid",
          "listingId",
          "verifiedBooking",
          "fraudFlags",
          "reportCount",
          "helpfulCount",
          "moderationState"
        ]);
      allow delete: if false;

      match /replies/{replyId} {
        allow read: if get(/databases/$(database)/documents/reviews/$(reviewId)).data.status == "published";
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && get(/databases/$(database)/documents/reviews/$(reviewId)).data.status == "published"
          && request.resource.data.moderationState == "pending"
          && request.resource.data.helpfulCount == 0
          && request.resource.data.reportCount == 0;
        allow update: if signedIn()
          && resource.data.authorUid == request.auth.uid
          && unchangedProtectedFields([
            "authorUid",
            "reviewId",
            "moderationState",
            "helpfulCount",
            "reportCount",
            "createdAt"
          ]);
        allow delete: if false;
      }
    }

    match /reviewReports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isModerator();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantUids;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && unchangedProtectedFields(["participantUids", "createdAt"]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        // Only confirmed conversation participants may write messages into the thread.
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if false;
      allow delete: if signedIn() && resource.data.recipientUid == request.auth.uid;
    }

    match /mediaAssets/{mediaId} {
      allow read: if resource.data.visibility == "public"
        || (signedIn() && resource.data.visibility == "authenticated")
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isModerator();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && unchangedProtectedFields(["ownerUid", "moderationState", "createdAt"]);
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analyticsEvents/{eventId} {
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /searchHistory/{historyId} {
      allow read, delete: if signedIn() && request.auth.uid == resource.data.uid;
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
